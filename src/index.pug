doctype html
mixin handDrawnArrow(iconClass, rotation)
  svg(class=iconClass viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
    g(transform=`rotate(${rotation} 12 12)`)
      path(d="M12.7 20.2C11.5 16.6 12.8 12.8 12.1 9.6C11.8 7.7 12.4 5.8 12.1 4.1M5.1 11.3C7.1 8.9 9.6 6.5 12.1 4.1C14.1 6.6 16.8 8.5 18.6 10.8")
html(lang="ko")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="theme-color" content="#ece8df")
    meta(name="description" content="웹 퍼블리셔 NeoDahl의 포트폴리오입니다.")
    title NeoDahl | Portfolio
    link(rel="icon" type="image/png" sizes="32x32" href="/src/images/favicon-32.png")
  body
    a.skip-link(href="#main-content") 본문 바로가기
    header.site-header
      .site-header__inner
        a.site-logo(href="#about" aria-label="NeoDahl, About로 이동")
          span.site-logo__wordmark(aria-hidden="true")
            span.site-logo__initial N
            span.site-logo__fade e
            span.site-logo__fade o
            span.site-logo__initial D
            span.site-logo__fade a
            span.site-logo__fade h
            span.site-logo__fade l
        nav.primary-nav(aria-label="주요 메뉴")
          ul.primary-nav__list
            li: a.primary-nav__link(href="#about") About
            li: a.primary-nav__link(href="#skills") Skills
            li: a.primary-nav__link(href="#career") Career
            li: a.primary-nav__link(href="#contact") Together
        .theme-toggle-slot
          button.theme-toggle(type="button" aria-label="테마 설정" aria-pressed="false" title="테마 변경")
            span.theme-toggle__thumb
              svg.theme-toggle__icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
                path.theme-toggle__moon(d="M10.2 3.2C6.5 4 3.8 7.3 3.9 11.5c.1 4.8 3.7 8.5 8.5 8.7 3.5.1 6.4-1.6 7.8-4.3-3.1.7-6.1-.1-8-2.2-2-2.2-2.6-6.4-2-10.5Z")
                g.theme-toggle__sun
                  path(d="M12.1 7.7c2.4-.1 4.2 1.8 4.2 4.1.1 2.4-1.8 4.4-4.2 4.4-2.3.1-4.3-1.8-4.3-4.2-.1-2.4 1.8-4.2 4.3-4.3ZM11.8 2.2l.2 2.5m.2 14.6-.1 2.4M2.4 12.2l2.4-.2m14.4-.1 2.4.2M5.3 5.5l1.8 1.7m9.9 9.8 1.7 1.6M18.5 5.1l-1.7 2M7.1 17l-1.9 1.7")
            
    main#main-content
      section#about.about-section.section-shell(aria-labelledby="about-title")
        .about-section__intro
          p.about-section__kicker 생각을 읽고, 화면으로 답하다
          h1#about-title.about-section__title
            span.about-section__title-line
              span.about-section__title-text.about-section__title-text--role Web Publisher
            br
            span.about-section__title-line
              span.about-section__title-text
                em NeoDahl
          p.about-section__summary
            | 안녕하세요, 네오달입니다.
            br
            | 말로 다 전해지지 않은 의도까지
            br 
            | 함께 소통하며 더 나은 웹을 만듭니다.
        .about-section__art(aria-hidden="true")
          .about-art__frame
            .about-art__sun
            .about-art__line.about-art__line--one
            .about-art__line.about-art__line--two
          p.about-section__note Where Complexity Meets Simplicity
      section#approach.approach-section.section-shell(aria-labelledby="approach-title")
        .approach-section__heading.section-heading
          p.section-heading__eyebrow APPROACH
          h2#approach-title.section-heading__title 웹을 만드는 기준
          p.section-heading__description 사용자의 경험과 멋진 웹사이트를 만드는 과정 모두 중요합니다.
        .approach-grid
          article.approach-card
            h3.approach-card__title 누구나 편리하게
            p.approach-card__description Sematic Markup과 웹 접근성을 바탕으로, 다양한 사용자가 막힘없이 이용할 수 있게 고민합니다.
          article.approach-card
            h3.approach-card__title 빠르고 안정적으로
            p.approach-card__description 디바이스의 다양함을 고려한 어떤 환경에서도 자연스러운 경험을 할 수 있도록 만듭니다.
          article.approach-card
            h3.approach-card__title 함께 오래 쓰도록
            p.approach-card__description 의도를 정확히 파악하고, 수정과 확장을 고려한 코드로 완성합니다.
      section#skills.skills-section.section-shell(aria-labelledby="skills-title")
        .section-heading
          p.section-heading__eyebrow SKILLS
          h2#skills-title.section-heading__title 멋진 웹을 완성하는 기술
          p.section-heading__description 더 나은 웹을 위해 쌓아온 기술과 경험.
        .skills-grid
          article.skill-card
            h3.skill-card__title Markup
            ul.skill-card__list(aria-label="마크업 기술")
              li HTML
              li Pug
          article.skill-card
            h3.skill-card__title Style
            ul.skill-card__list(aria-label="스타일 기술")
              li Dart Sass
          article.skill-card
            h3.skill-card__title Interaction
            ul.skill-card__list(aria-label="인터랙션 기술")
              li JavaScript
              li TypeScript
              li jQuery
              li Libraries &amp; Plugins
          article.skill-card
            h3.skill-card__title Tools &amp; Workflow
            ul.skill-card__list(aria-label="협업 및 개발 도구")
              li VS Code
              li Git
              li GitLab
              li SoureTree
              li Figma
              li Gulp
              li Vite
              li JIRA
      section#career.career-section.section-shell(aria-labelledby="career-title")
        .section-heading
          p.section-heading__eyebrow CAREER
          h2#career-title.section-heading__title 쌓아온 시간
          p.section-heading__description 사이트 운영과 #[span.career-section__latin UI] 개발, 웹 접근성 개선까지 이어온 경험
        article.career-entry
          p.career-entry__period
            time(datetime="2021-03") 2021.03
            span(aria-hidden="true") —
            time(datetime="2026-10") 2026.10
          .career-entry__details
            h3.career-entry__company: span.career-section__latin LG CNS
            p.career-entry__role 70여 개 국가 #[span.career-section__latin LG.com] 글로벌 사이트 관리
        article.career-entry.career-entry--previous
          p.career-entry__period
            time(datetime="2020-11") 2020.11
            span(aria-hidden="true") —
            time(datetime="2021-01") 2021.01
          .career-entry__details
            h3.career-entry__company 인재#[span.career-section__latin INC]
            p.career-entry__role 한국재정정보원의 웹 접근성 개선 작업 참여
        article.career-entry.career-entry--previous
          p.career-entry__period
            time(datetime="2020-01") 2020.01
            span(aria-hidden="true") —
            time(datetime="2020-10") 2020.10
          .career-entry__details
            h3.career-entry__company 스마트퓨쳐
            p.career-entry__role 자사 서비스를 운영, 이벤트 페이지 제작 등
        article.career-entry.career-entry--previous
          p.career-entry__period
            time(datetime="2019-03") 2019.03
            span(aria-hidden="true") —
            time(datetime="2019-12") 2019.12
          .career-entry__details
            h3.career-entry__company 한신정보기술
            p.career-entry__role 공공기관 사이트 운영, 웹 접근성 인증 마크 획득
        article.career-entry.career-entry--previous
          p.career-entry__period
            time(datetime="2018-02") 2018.02
            span(aria-hidden="true") —
            time(datetime="2019-01") 2019.01
          .career-entry__details
            h3.career-entry__company 개념원리
            p.career-entry__role 사이트 운영과 #[span.career-section__latin UI] 개발, 이벤트 페이지 제작
        article.career-entry.career-entry--previous
          p.career-entry__period
            time(datetime="2016-01") 2016.01
            span(aria-hidden="true") —
            time(datetime="2018-01") 2018.01
          .career-entry__details
            h3.career-entry__company 타이탄 플랫폼
            p.career-entry__role 사이트 운영부터 #[span.career-section__latin UI] 개발 및 이벤트 페이지 제작

        section#projects.projects-section(aria-labelledby="projects-title")
          .section-heading.section-heading--projects
            p.section-heading__eyebrow PROJECTS
            h3#projects-title.section-heading__title 다양한 경험
            p.section-heading__description 참여한 프로젝트와 역할, 사용 기술을 소개합니다.
          .project-slider
            .project-slider__controls(aria-label="프로젝트 슬라이드 조작")
              button.project-slider__button.project-slider__button--previous(type="button" aria-label="이전 프로젝트" disabled)
                +handDrawnArrow("project-slider__icon", -90)
              button.project-slider__button.project-slider__button--next(type="button" aria-label="다음 프로젝트")
                +handDrawnArrow("project-slider__icon", 90)
            .swiper.project-slider__viewport(role="region" tabindex="0" aria-label="프로젝트 슬라이드")
              .project-grid.swiper-wrapper
                article.project-card.project-card--featured.swiper-slide
                  .project-card__image-wrap
                    img.project-card__image(src="/src/images/lg-responsive-thumbnail.jpg" alt="데스크톱, 태블릿, 모바일에서 본 LG.com 화면" width="1448" height="1086" loading="lazy")
                  .project-card__content
                    p.project-card__category: span.project-card__latin GLOBAL WEB · 2021—2026
                    h4.project-card__title #[span.project-card__latin LG.com] 글로벌 사이트 관리
                    p.project-card__role 글로벌 사이트 운영
                    p.project-card__description 다양한 국가와 환경을 고려하며 #[span.project-card__latin LG.com] 글로벌 사이트를 운영·관리했습니다.
                    ul.project-card__tags(aria-label="사용 기술")
                      li HTML
                      li Sass
                      li JavaScript
                      li Git
                article.project-card.swiper-slide
                  .project-card__image-wrap
                    img.project-card__image(src="/src/images/smartfuture-thumbnail.jpg" alt="노다지 주식정보 앱 화면과 스마트폰" width="1600" height="1000" loading="lazy")
                  .project-card__content
                    p.project-card__category: span.project-card__latin Mobile App · 2020
                    h4.project-card__title 스마트 퓨처
                    p.project-card__role 앱 퍼블리싱
                    p.project-card__description 주식정보 앱 노다지의 모든 퍼블리싱을 담당했습니다.
                    ul.project-card__tags(aria-label="사용 기술")
                      li HTML
                      li Sass
                      li jQuery
                article.project-card.swiper-slide
                  .project-card__image-wrap
                    img.project-card__image(src="/src/images/geumcheon-responsive.jpg" alt="금천구 홈페이지의 데스크톱, 태블릿, 모바일 화면" width="1448" height="1086" loading="lazy")
                  .project-card__content
                    p.project-card__category 공공기관 · #[span.project-card__latin 2019]
                    h4.project-card__title 금천구청 홈페이지
                    p.project-card__role 사이트 관리 및 #[span.project-card__latin WA]마크 획득
                    p.project-card__description 금천구청에서 관리하는 모든 웹 사이트 관리했습니다.
                    ul.project-card__tags(aria-label="사용 기술")
                      li HTML
                      li Sass
                      li jQuery
                article.project-card.swiper-slide
                  .project-card__image-wrap
                    img.project-card__image(src="/src/images/ajou-cancer-center.png" alt="아주대학교병원 암센터 홈페이지 화면" width="1244" height="768" loading="lazy")
                  .project-card__content
                    p.project-card__category 의료기관 · #[span.project-card__latin 2018]
                    h4.project-card__title 아주대학교 병원 암센터
                    p.project-card__role 홈페이지 리뉴얼
                    p.project-card__description 아주대학교 병원 암센터 홈페이지의 리뉴얼을 진행했습니다.
                    ul.project-card__tags(aria-label="사용 기술")
                      li HTML
                      li CSS
                      li jQuery
                      li SVN
      section#contact.contact-section.section-shell(aria-labelledby="contact-title")
        .section-heading.contact-section__heading
          h2#contact-title.section-heading__title.contact-section__title
            span.contact-section__title-accent 더 멋진 웹,
            br
            | 함께 만들어 볼까요?
        .contact-section__bottom
          p.contact-section__copy 완성도 높은 더 나은 웹 경험을 만들어봐요.
    footer.site-footer
      p.site-footer__copyright
        span.site-footer__copyright-symbol ©
        |  2026
        span.site-footer__copyright-name NeoDahl
      span.site-footer__ornament
        | neodahl90
        span.site-footer__ornament-at @
        | gmail.com
      a.site-footer__back(href="#about" aria-label="맨 위로 이동")
        +handDrawnArrow("site-footer__back-icon", 0)
    script(type="module" src="/src/scripts/main.js")
